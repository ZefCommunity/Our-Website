{
  "redirects": [
    {
      "source": "/enroll",
      "destination": "/enrol",
      "permanent": true
    },
    {
      "source": "/enroll/",
      "destination": "/enrol",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
